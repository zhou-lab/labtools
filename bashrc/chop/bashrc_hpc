## ff <file-or-url> : open a page in Firefox and return the prompt immediately.
## setsid fully detaches it (new session, survives closing this pane/tmux),
## and stdio is redirected so Firefox never writes to or holds the terminal.
## A bare local path is turned into a file:// URL so `ff page.html` just works.
ff() {
    local target="$1"
    if [ -e "$target" ]; then                 # local file -> absolute file:// URL
        target="file://$(cd "$(dirname "$target")" && pwd)/$(basename "$target")"
    fi
    setsid firefox "$target" >/dev/null 2>&1 < /dev/null &
}
