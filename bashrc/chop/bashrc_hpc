## Emacs: terminal (no-window) client into a single shared daemon.
## -t opens a TTY frame in this terminal; -a "" auto-starts the one daemon on
## first use, so every `emacs' — interactive, git commit, crontab — reuses the
## same server and therefore the same buffers, kill ring and open files.
## Finish an editor-invoked session with C-x # (not C-x C-c) to hand the file
## back to the waiting caller without tearing the frame down twice.
## Batch/daemon flags are passed straight to the real binary: this bashrc sets
## `shopt -s expand_aliases', so the alias below also fires under `bash -lc',
## where `emacs --batch ...' in a script must not become an emacsclient frame.
function start_emacs() {
  case "$1" in
    -Q|-q|--batch|--script|--daemon|--fg-daemon|--bg-daemon|--version|--help)
      command emacs "$@" ;;
    *)
      emacsclient -t --alternate-editor="" "$@" ;;
  esac
}
alias emacs=start_emacs
export EDITOR='emacsclient -t -a ""'
