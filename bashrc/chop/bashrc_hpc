function mergeCG2() {
  fdr=$1
  fn=$2
  :>$fn
  find $fdr -name '*.cac' -o -name '*.cg' -o -name '*.cm' | sort | while read f; do cat $f >>$fn; yame index -1 $(basename $(basename $(basename $f .cg) .ca) .cm) $fn; done
}

function parallelTest() {
  kset=$1
  qset=$2
  outf=$3
  mkdir ${outf}_tmp
  cut -f1 ${kset}.idx | while read f; do echo -e $kset"\t"$f"\t"$qset"\t"${outf}_tmp; done | parallel --col-sep "\t" -j 20 'yame subset {1} {2} | yame summary -m - {3} >{4}/{2}'
  awk 'NR==1||$1!="QFile"{n = split(FILENAME, a, "/"); if (NR==1) {aa="Query0";} else {aa=a[n];} print aa,$0;}' ${outf}_tmp/* >$outf;
}



